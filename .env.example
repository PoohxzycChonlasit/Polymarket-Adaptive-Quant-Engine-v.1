APP_NAME="PolyTrade Bot"
APP_ENV="development"
LOG_LEVEL="INFO"
LOG_DIR="logs"
PAPER_TRADING=true
DRY_RUN=true

# ── Paper balance source ──────────────────────────────────────────────────────
# virtual           (default) Isolated paper virtual cash; never reads wallet.
# wallet_reference  Reads real CLOB wallet balance as a read-only sizing
#                   reference. Execution remains PAPER ONLY; no live orders.
#                   Requires POLYMARKET_PRIVATE_KEY / API credentials.
PAPER_BALANCE_SOURCE=virtual
WALLET_REFERENCE_REFRESH_SECONDS=300

AI_TIMEOUT_SECONDS=45

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

POLYMARKET_HOST="https://clob.polymarket.com"
POLYMARKET_GAMMA_URL="https://gamma-api.polymarket.com"
POLYMARKET_CHAIN_ID=137
POLYMARKET_PRIVATE_KEY=""
POLYMARKET_FUNDER=""
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_WS_URL="wss://ws-subscriptions-clob.polymarket.com/ws/"
POLYMARKET_API_KEY=""
POLYMARKET_API_SECRET=""
POLYMARKET_API_PASSPHRASE=""

CRYPTO_EXCHANGE="coinbase"
CRYPTO_TIMEFRAME="1m"
CRYPTO_PAIRS="BTC/USD,ETH/USD,SOL/USD,XRP/USD,DOGE/USD,BNB/USD"
CRYPTO_STAKE_CURRENCY="USD"
CRYPTO_DRY_RUN=true

BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BYBIT_API_KEY=""
BYBIT_API_SECRET=""
COINBASE_API_KEY=""
COINBASE_API_SECRET=""
COINBASE_API_PASSPHRASE=""

ACCOUNT_BALANCE=10000.0
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_DRAWDOWN=0.03
DEFAULT_STOP_LOSS_PCT=0.02
DEFAULT_TAKE_PROFIT_PCT=0.03
MAX_OPEN_POSITIONS=3
MAX_TOTAL_EXPOSURE=0.30
KELLY_FRACTION_CAP=0.25

# ── Backtest tuning ──────────────────────────────────────────────────────────
# Min edge % to enter a trade. 3.0=aggressive (8-20% of windows), 5.0=moderate, 8.0=strict
BACKTEST_MIN_EDGE=3.0

# ── Vultr paper-run deployment ───────────────────────────────────────────────
# Used only by scripts/vultr_deploy_paper.py. Keep VULTR_API_KEY out of git.
VULTR_API_KEY=""
VULTR_REGION="sgp"
VULTR_PLAN="vc2-1c-1gb"
VULTR_OS_ID=1743
VULTR_LABEL="polytrade-hft-paper"
VULTR_SSH_KEY_ID=""
POLYTRADE_REPO_URL=""
POLYTRADE_BRANCH="main"
HFT_PAPER_DURATION_HOURS=48
